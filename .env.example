# Senha do painel /admin (mínimo 12 caracteres)
ADMIN_PASSWORD=
# Segredo para assinar o cookie de sessão (mínimo 32 caracteres)
# gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# URL pública do site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: onde ficam content.json e uploads/ (padrão ./storage)
# STORAGE_DIR=./storage
# Opcional: 1 bloqueia gravações (ativado automaticamente na Vercel)
# CONTENT_READONLY=0
